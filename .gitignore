/target
# `/target` is ROOT-ANCHORED, so a cargo invocation whose working directory is a
# subdirectory (running a harness from bench/, say) silently creates an UNIGNORED
# second target tree there. Catch those too.
**/target/
**/*.rs.bk
*.pdb

# Native test fixture (the health metric), kept locally not in VCS
/server.jar

# Server runtime files generated by a local boot (never in VCS)
/eula.txt
/world/
/logs/
/server.properties
/crash-reports/

# Minecraft runtime assets extracted locally for boot/bench (never in VCS):
# dependency jars (fastutil, guava, …) + the unobfuscated version jar.
/libraries/
/versions/

# Scratch space for behaviour-comparison runs against the real JDK
# (extract server.jar / run `java -jar` here, never in the working tree)
/.scratch/
*.log
bench/out/
testjars/
server.jar
rava.toml

# sandbox-gc is a standalone crate with its own workspace/target
crates/sandbox-gc/target/

# MC server runtime files
banned-ips.json
banned-players.json
ops.json
usercache.json
whitelist.json
boot*.log
boot*.err
boot*.pid
cold*.log
cold.pid
jvm*.log
sf_*.log
probe*.log
cls*.log

# build/forensic debris
/clif.txt
/out/
# per-harness classpath dirs (corpus/numeric/run.sh and friends compile into one
# of their own so parallel runs never share `out/`)
/out_*/
bench/logs/
target2/
target3/
target-gc-baseline/
.bench-*/

*.log.err
bench/*.err

world_pristine/

# A/B + census run artifacts (regenerated by bench/*_ab.ps1 and the census probes)
bench/*.csv
bench/*.done
bench/*.out
bench/out[A-Z].txt
bench/err[A-Z].txt
bench/server.properties
bench/usercache.json
# BootPhaseC runs from bench/, so it needs a world save there — a copied fixture.
bench/world/
bench/.continuum/
.continuum/daemon.lock
/mcrun/
/bench/probe_*.log*
/bench/boot_*.log*
# tls_crossing_census.ps1 output (the .log/.err are already covered by *.log)
/bench/tlscensus_*

# Benchmark binaries: two-binary A/Bs copy 13 MB exes into bench/. A stray `git add -A`
# committed two of them (85a3a6a); they are build outputs, never sources.
bench/*.exe
bench/*.log
bench/*.log.err
bench/*.out

# Another agent runtime's workspace — not part of this project.
.opencode/

# Continuum daemon state: a local SQLite db plus a graph.json that reached 235 MB in this
# repo's history and is what GitHub's 100 MB limit rejected. None of it is source.
.continuum/

# interpreter A/B scratch output (regenerated by bench/interp_ab.ps1)
bench/interp_ab_*.txt.err
# Bisection transcripts, same reason: an output of a measurement, never an input
# to one. The ATTRIBUTION they produce belongs in docs/boot-speed-ledger.md.
bench/*_ab.err
bench/bin/
bench/sweep_*.err
bench/gab_*.log*

# EVERY batch transcript a harness writes lands in bench/ as a .txt, and this file grew a
# one-off line for each of them — `order_flag.txt`, `bisect_block.txt`, `prod_abba.txt`,
# a dozen more — until the ignore list was a diary. One rule instead: bench/ .txt is
# OUTPUT by default. The five that are real inputs are already TRACKED, and .gitignore
# has no say over a tracked file, so they are listed here only to say they are deliberate.
bench/*.txt
!bench/jvm_cl_classes.txt
!bench/jvm_comp.txt
!bench/micro_1.txt
!bench/micro_2.txt
!bench/micro_tmp.txt
jdk-out/

# compiled probes/benchmarks are rebuilt by their harnesses
bench/*.class
__pycache__/
target-prewave/
target-presm/
target-headref/

# Stray PGO/product binary copies left by bench scripts (never in VCS)
/product

# Server-start A/B runs (bench/paper_ab.sh): local measurements, summarized in docs/core/progress.md
bench/results/
